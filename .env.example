# Copy to .env for local use. Never commit the real .env file.
PORT=8080
APP_VERSION=1.0.0
GIT_SHA=dev
# Optional: lets the dashboard show recent pipeline runs (public repo needs no token)
GITHUB_REPO=your-username/deployeasy
GITHUB_TOKEN=
# Shared with the GitHub Actions repository secret for signed deployment result callbacks.
DEPLOYEASY_CALLBACK_SECRET=
# Optional secret for verified GitHub workflow_run webhooks (including push releases).
GITHUB_WEBHOOK_SECRET=
